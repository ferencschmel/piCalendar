# Copy to .env and adjust. Every value here is the built-in default, so an
# empty .env is a valid configuration.

# ---- Server ---------------------------------------------------------------
NODE_ENV=production
PORT=4000
# 0.0.0.0 exposes the app to the LAN, which is the point of a wall display.
# Use 127.0.0.1 if you put nginx in front of it.
HOST=0.0.0.0
LOG_LEVEL=info

# ---- Database -------------------------------------------------------------
# Absolute path recommended in production; the directory is created if missing.
DATABASE_PATH=/var/lib/picalendar/picalendar.sqlite

# ---- Display --------------------------------------------------------------
# IANA zone the wall display renders in. All-day events and day bucketing are
# resolved against this, so setting it wrong shifts events by a day.
DISPLAY_TIMEZONE=Europe/Budapest

# Built frontend assets served by the backend. Leave SERVE_STATIC=false if you
# host the SPA separately (e.g. from nginx).
SERVE_STATIC=true
STATIC_DIR=/opt/picalendar/apps/frontend/dist

# Origins allowed to call the API cross-origin. Only needed for `npm run dev`,
# where Vite serves the SPA from a different port.
CORS_ORIGINS=http://localhost:5173

# Set to true ONLY if the dashboard is really reached over https, directly or
# through a TLS-terminating proxy. It turns on HSTS and CSP's
# upgrade-insecure-requests; over plain http those make the browser fetch the
# JS/CSS bundle over https, which fails, and the page renders blank.
HTTPS_ENABLED=false

# ---- Feed synchronisation -------------------------------------------------
SYNC_ENABLED=true
# How often the scheduler checks which feeds are due. Each feed has its own
# refresh interval on top of this; the tick is just the resolution.
SYNC_TICK_SECONDS=60
SYNC_ON_STARTUP=true
SYNC_TIMEOUT_MS=20000

# Rolling window of pre-computed event occurrences, relative to now. Widening
# the future window costs storage and sync time; it does not slow the dashboard.
OCCURRENCE_WINDOW_PAST_DAYS=14
OCCURRENCE_WINDOW_FUTURE_DAYS=180

# ---- Presence (camera, future) -------------------------------------------
# How long a detection keeps someone counted as "in the room".
PRESENCE_WINDOW_SECONDS=300

# ---- Security -------------------------------------------------------------
# Shared bearer token for the admin and presence-ingest endpoints. Leave unset
# on a trusted home LAN; set it before exposing the Pi to anything else.
# ADMIN_TOKEN=change-me
